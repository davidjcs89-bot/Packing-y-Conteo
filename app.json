{
  "expo": {
    "name": "Packing-y-Conteo de productos ya comprados",
    "slug": "packing-y-conteo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "packingyconteo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.davidjcs89.packingyconteo",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E7C66",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.davidjcs89.packingyconteo"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C66",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Packing-y-Conteo usa tus fotos para agregar imágenes a los artículos.",
          "cameraPermission": "Packing-y-Conteo usa la cámara para fotografiar artículos y escanear códigos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "davidjcs89",
    "extra": {
      "eas": {
        "projectId": "590c5246-b27a-454c-a72c-452247d04988"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/590c5246-b27a-454c-a72c-452247d04988",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
